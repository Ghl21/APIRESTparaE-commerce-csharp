    {
      "name": "4. Compra (checkout y pagos)",
      "item": [
        {
          "name": "Checkout: crear pedido desde el carrito",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Pedido creado (201)', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "if (pm.response.code === 201) {",
                  "    const data = pm.response.json();",
                  "    pm.collectionVariables.set('orderId', data.id);",
                  "    console.log('Pedido ' + data.orderNumber + ' creado por un total de ' + data.total);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"shippingAddressId\": 1,\n  \"notes\": \"Entregar por la tarde\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/orders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "orders"]
            },
            "description": "Convierte el carrito en pedido, descuenta el stock y deja el pedido en estado Pending. Guarda el id en la variable orderId."
          },
          "response": []
        },
        {
          "name": "Pagar el pedido (aprobado)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": {{orderId}},\n  \"method\": \"CreditCard\",\n  \"cardNumber\": \"4111111111111111\",\n  \"cardHolderName\": \"MARIA GONZALEZ\",\n  \"expirationDate\": \"12/29\",\n  \"cvv\": \"123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/payments",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "payments"]
            },
            "description": "Pasarela simulada. Si se aprueba, el pedido pasa a Paid. Solo se guardan los ultimos 4 digitos de la tarjeta."
          },
          "response": []
        },
        {
          "name": "Pagar el pedido (rechazado)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": {{orderId}},\n  \"method\": \"CreditCard\",\n  \"cardNumber\": \"4111111111110000\",\n  \"cardHolderName\": \"MARIA GONZALEZ\",\n  \"expirationDate\": \"12/29\",\n  \"cvv\": \"123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/payments",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "payments"]
            },
            "description": "Las tarjetas terminadas en 0000 se rechazan a proposito. El pedido sigue en Pending."
          },
          "response": []
        },
        {
          "name": "Mis pedidos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/orders?pageNumber=1&pageSize=10",
